# Copie para .env (web) ou .env.production (build Android) — NÃO versione o .env
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=chave-anon-publica
# A chave da OpenRouter NÃO vai aqui: configure como secret da Edge Function `ia-imagem`
#   supabase secrets set OPENROUTER_KEY=...
# Nome da Edge Function de redefinir senha. O código está em supabase/functions/admin-reset-senha;
# em produção ela foi publicada como "bright-worker". Reimplante com o nome do repositório
# (supabase functions deploy admin-reset-senha) ou defina aqui o nome publicado.
# VITE_FN_RESET_SENHA=admin-reset-senha
# URL pública do site (destino do link de "Esqueci minha senha") e e-mail de suporte
VITE_APP_URL=https://app.mkorp.com.br
VITE_EMAIL_SUPORTE=suporte@mkorp.com.br
